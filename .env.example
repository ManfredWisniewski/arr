# Local dev container — generate: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URI=postgresql://payload_test:payload_test@localhost:5432/payload_test
PAYLOAD_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret

# Google Search Console sitemap resubmission (optional — all three or none).
# GSC_SITE: property id, e.g. sc-domain:example.com or https://example.com/
# GSC_CLIENT_EMAIL / GSC_PRIVATE_KEY: service account added as a user on
# that property; PEM private key with newlines escaped as \n
# GSC_SITE=sc-domain:example.com
# GSC_CLIENT_EMAIL=name@project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# publish credentials live in sites/<site>/.env (see sites/.env.example)
