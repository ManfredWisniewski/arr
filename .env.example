# Local dev container — generate: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URI=postgresql://payload_test:payload_test@localhost:5432/payload_test
PAYLOAD_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret

# Visitor chat widget (optional; unset = widget hidden, /api/chat → 404)
# n8n webhook that answers chatInput payloads; secret sent as Bearer header.
# CHAT_WEBHOOK_URL=https://n8n.example.org/webhook/chat/site/v1
# CHAT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# CHAT_TITLE=Assistent
# CHAT_GREETING=Womit kann ich helfen?
# CHAT_DISCLOSURE=Ich bin ein KI-Assistent. …

# publish credentials live in sites/<site>/.env (see sites/.env.example)
